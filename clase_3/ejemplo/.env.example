# ============================================================
# Archivo de ejemplo para variables de entorno.
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como .env
# 2. Reemplaza los valores con tus credenciales reales de Supabase.
# 3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
#
# ¿Dónde encuentro estos valores?
# - Entra a tu proyecto en Supabase.
# - Ve a Project Settings > API.
# - Copia la "Project URL" y la "anon public" API key.
# ============================================================

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_clave_de_supabase
APP_NAME=API Clase 3
